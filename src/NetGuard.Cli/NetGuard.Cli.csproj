<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>netguard</AssemblyName>
    <RootNamespace>NetGuard.Cli</RootNamespace>
    <Product>NetGuard — межсетевой экран с фильтрацией пакетов</Product>
    <InvariantGlobalization>false</InvariantGlobalization>

    <!--
      RuntimeIdentifier обязателен: WinDivert — нативная библиотека, и без RID
      сборка кладёт WinDivert.dll и WinDivert64.sys в runtimes/, но не
      регистрирует их в deps.json. В результате P/Invoke падает с
      DllNotFoundException уже в момент запуска от администратора.
      Windows x64 задан явно: драйвер 64-разрядный.
    -->
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <!-- Веб-интерфейс работает в том же процессе, поэтому CLI и HTTP
         используют один экземпляр движка и один дескриптор перехвата. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\NetGuard.Core\NetGuard.Core.csproj" />
  </ItemGroup>

</Project>